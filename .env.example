# ============================================================
# AI 个人知识库助手 - 根环境变量
# 用法: cp .env.example .env 然后填入真实值
# 该文件会被 docker compose 注入到 backend / celery_worker 容器
# ============================================================

# ---------- LLM 供应商切换 ----------
# 可选值: openai | zhipu
LLM_PROVIDER=openai

# OpenAI (兼容任意 OpenAI 协议的网关，可改 OPENAI_BASE_URL)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# 智谱 GLM (国内网络可用)
ZHIPU_API_KEY=
ZHIPU_CHAT_MODEL=glm-4
ZHIPU_VISION_MODEL=glm-4v
ZHIPU_EMBEDDING_MODEL=embedding-2

# 音频转写 (Whisper API，需要 OpenAI 兼容接口；智谱无 Whisper 等价服务)
OPENAI_WHISPER_MODEL=whisper-1

# ---------- 安全 (生产环境务必修改) ----------
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
