# ===== 数据库 =====
# 本地开发默认 SQLite；Docker Compose 会自动注入 Postgres
DATABASE_URL=sqlite:///./knowledge_db.db

# Celery broker (本地单机开发可不配置，见 USE_CELERY)
REDIS_URL=redis://localhost:6379/0

# ===== LLM 供应商切换 =====
# 可选值: openai | zhipu
LLM_PROVIDER=openai

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_WHISPER_MODEL=whisper-1

ZHIPU_API_KEY=
ZHIPU_CHAT_MODEL=glm-4
ZHIPU_VISION_MODEL=glm-4v
ZHIPU_EMBEDDING_MODEL=embedding-2

# ===== 安全 =====
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ===== 异步任务模式 =====
# true: Celery Worker (生产)；false: FastAPI BackgroundTasks (本地调试)
USE_CELERY=false
