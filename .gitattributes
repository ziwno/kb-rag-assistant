# 统一换行符: 文本文件入库用 LF，检出时按平台转换
* text=auto

# 脚本类强制 LF (避免 Windows 检出为 CRLF 导致容器内执行出错)
*.py text eol=lf
*.sh text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf

# 锁定二进制
*.db binary
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.pdf binary
